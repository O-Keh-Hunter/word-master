# 后端服务端口
PORT=3000

# 前端子路径部署时设置（需与构建镜像时的 Vite --build-arg VITE_BASE_URL 保持一致）
# 告知 Express 静态文件托管在哪个路径下，根路径部署留空或设为 /
APP_BASE_PATH=/

# 允许跨域的额外来源（生产环境前后端同源时无需配置）
# 仅当前端与后端分开部署时才需要填写，如：https://yourdomain.com
CORS_ORIGIN=

# 数据库文件路径（相对于 backend 目录）
DB_PATH=./data/word-master.db

# 语音服务商选择（默认 local，无需云端密钥）
# local: SenseVoice Small 识别 + Kokoro-82M 朗读
# xunfei:  科大讯飞（Spark IAT / 在线合成 v2）
# tencent: 腾讯云（实时语音识别，16k_zh_en 中英混合引擎）
STT_PROVIDER=local
TTS_PROVIDER=local
# 留空：本机开发使用 http://127.0.0.1:8001，Compose 使用 http://speech:8001
# 也可填入局域网中单独运行模型的电脑地址
LOCAL_SPEECH_URL=

# 讯飞开放平台配置（在 https://www.xfyun.cn 注册后获取）
XUNFEI_APP_ID=your_app_id_here
XUNFEI_API_KEY=your_api_key_here
XUNFEI_API_SECRET=your_api_secret_here

# 腾讯云配置（在 https://console.cloud.tencent.com/cam/capi 获取）
# 仅 STT_PROVIDER=tencent 时需要
TENCENT_APP_ID=your_app_id_here
TENCENT_SECRET_ID=your_secret_id_here
TENCENT_SECRET_KEY=your_secret_key_here

# AI 账号管理密码（保护全站共享的 Google OAuth 账号设置，请自行设置强密码）
AI_ADMIN_PASSWORD=

# 与 Antigravity 协议兼容的 OAuth 客户端配置，只在服务端填写（详见 docs/antigravity.md）
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=

# Antigravity OAuth 使用的 Gemini 模型（无需 Gemini / DeepSeek API Key）
ANTIGRAVITY_MODEL=gemini-3-flash
# 可选：账号令牌文件，默认 ./data/antigravity-account.json
# 必须位于服务端私有目录；Docker 默认随 data 卷持久化
# ANTIGRAVITY_AUTH_FILE=./data/antigravity-account.json
